# ============================================================
#  Telegram Bot
# ============================================================

# Токен бота от @BotFather
BOT_TOKEN=

# Твой Telegram ID (узнать у @userinfobot)
ADMIN_ID=

# Username поддержки без @ (Enter = пропустить)
SUPPORT_USERNAME=

# Название сервиса в текстах бота
BRAND_NAME=VPN

# ============================================================
#  Обязательная подписка на инфо-канал (опционально)
# ============================================================
# Если пусто — проверка подписки отключена
INFO_CHANNEL_USERNAME=
INFO_CHANNEL_URL=

# ============================================================
#  Юридические ссылки
# ============================================================
LEGAL_PRIVACY_URL=https://telegra.ph/
LEGAL_TERMS_URL=https://telegra.ph/

# ============================================================
#  Партнёрская ссылка Stars (опционально)
# ============================================================
# Если пусто — кнопка «Купить Stars у партнёра» не показывается
STARS_PARTNER_URL=

# ============================================================
#  Remnawave
# ============================================================
REMNAWAVE_URL=
REMNAWAVE_API_TOKEN=
REMNAWAVE_INTERNAL_SQUAD_UUID=
REMNAWAVE_SSL_VERIFY=true

# Поколение API Remnawave:
#   2.x  → пользователи идентифицируются по UUID (2.6, 2.7, 2.8)
#   3.x+ → пользователи идентифицируются по numeric id (3.0, 3.1, ...)
# Пусто = автоопределение при старте (запрос /api/system/metadata).
# Задать принудительно, если автоопределение не работает.
REMNAWAVE_API_GENERATION=

REMNAWAVE_SUBSCRIPTION_BASE_URL=

# ============================================================
#  Platega — оплата картой/СБП (опционально)
# ============================================================
PLATEGA_MERCHANT_ID=
PLATEGA_SECRET=
PLATEGA_API_BASE=https://app.platega.io

# Формат: RUB:STARS,RUB:STARS
PLATEGA_TOPUPS=100:25,200:50,400:100,800:200

PLATEGA_RETURN_URL=
PLATEGA_FAILED_URL=
PLATEGA_CALLBACK_HOST=127.0.0.1
PLATEGA_CALLBACK_PORT=8088

# ============================================================
#  Админ-уведомления — второй бот (опционально)
# ============================================================
ADMIN_NOTIFY_BOT_TOKEN=
ADMIN_NOTIFY_CHAT_ID=

# ============================================================
#  Фоновые процессы
# ============================================================
BACKGROUND_WORKER_ENABLED=false
AUTO_RENEW_ENABLED=true
AUTO_RENEW_FORCE_MONTH=false
RECONCILE_ENABLED=true
RECONCILE_AUTO_FIX=false
